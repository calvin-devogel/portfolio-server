  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            post_id, title, slug, sections as \"sections: serde_json::Value\",\n            excerpt, author, published, created_at, updated_at\n        FROM blog_posts\n        WHERE (NOT $1 OR published = true)\n        AND ($2::text IS NULL OR slug = $2)\n        ORDER BY created_at DESC\n        LIMIT $3 OFFSET $4",
